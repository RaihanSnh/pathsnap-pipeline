# Copy this file to ".env" and fill in your values. Never commit ".env" to git.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathsnap

# Optional: real ratings / prices (Google Places API, paid - see GUIDE)
GOOGLE_PLACES_API_KEY=

# Optional: AI hidden-gem scoring (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OUTPUT_LANGUAGE=English
